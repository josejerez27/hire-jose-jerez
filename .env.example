# Server-only. Never use NEXT_PUBLIC_ for this key.
# Use a Google AI Studio Free tier project with billing disabled.
# Leave blank for prepared portfolio answers without external AI calls.
GEMINI_API_KEY=

# Optional: public Spotify playlist share URL. Can also be set in profile.json.
SPOTIFY_PLAYLIST_URL=

# Optional Google Maps Embed API browser key. Restrict it to your domains
# and to the Maps Embed API. It is intentionally visible in the iframe URL.
GOOGLE_MAPS_EMBED_KEY=

# Optional durable rate limiting for Ask Jose. Set both or neither.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Private recommendation approval inbox. Choose a unique password of 16+ characters.
# Local submissions persist in ignored .data/. Vercel requires the Redis settings above.
RECOMMENDATION_ADMIN_PASSWORD=
